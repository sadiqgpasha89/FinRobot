<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ name }} ({{ ticker }}) — equity research</title>
<style>{{ css|safe }}</style></head>
<body>
<div class="cover">
  <div class="brand">Fin<b>Robot</b> · Equity Research</div>
  <h1>{{ name }} <span style="color:#7aa01c">({{ ticker }})</span></h1>
  <div class="sub">{{ period }} (quarter ended {{ period_end }}) · generated {{ generated }} · source data: SEC EDGAR filings{% if price %} · price {{ price_text }}{% endif %}</div>
  <div class="kpis">
    {% for k in kpis %}<div class="kpi"><div class="v">{{ k.value }}</div><div class="l">{{ k.label }}</div></div>{% endfor %}
  </div>
</div>
{% for s in sections %}
<section id="{{ s.key|replace(' ', '-')|lower }}">
  <h2><span class="n">{{ loop.index }}</span>{{ s.title }}</h2>
  {{ s.prose|safe }}
  {% for t in s.tables %}{{ t|safe }}{% endfor %}
  {% for c in s.charts %}<figure><img src="data:image/png;base64,{{ c.b64 }}" alt="{{ c.caption }}"><figcaption>{{ c.caption }}</figcaption></figure>{% endfor %}
</section>
{% endfor %}
{% for w in warnings %}<div class="note">{{ w }}</div>{% endfor %}
<div class="disclaimer">This report was generated by software from public SEC filings and the assumptions shown. It is a research aid, not investment advice, and
makes no recommendation to buy or sell any security. Figures marked with a superscript id can be traced in the appendix to the filing line or calculation they came from.
Valuation outputs are mechanical extrapolations of trailing data under stated assumptions, not forecasts.</div>
<div class="appendix">
  <h2>Appendix: sources and verification</h2>
  <div class="verify">Automated verification of the prose: <b>{{ verification.status }}</b> — {{ verification.claims }} figures checked,
  {{ verification.matched }} tied to registered data, {{ verification.grounded }} grounded in cited document passages{% if verification.removed %};
  {{ verification.removed }} unsupported statement(s) removed before publication{% endif %}.</div>
  <table class="fin"><caption>Figures cited in the text</caption><thead><tr><th>Id</th><th>Figure</th><th>Value</th><th>Source</th></tr></thead><tbody>
  {% for f in cited_facts %}<tr><td>{{ f.id }}</td><td>{{ f.label }}</td><td>{{ f.display }}</td><td>{{ f.source }}</td></tr>{% endfor %}</tbody></table>
  {% if cited_passages %}<table class="fin"><caption>Document passages cited</caption><thead><tr><th>Id</th><th>Document</th><th>Passage</th></tr></thead><tbody>
  {% for p in cited_passages %}<tr><td>{{ p.id }}</td><td>{{ p.doc }}</td><td>{{ p.snippet }}</td></tr>{% endfor %}</tbody></table>{% endif %}
</div>
</body></html>
