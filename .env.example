# SEC requires a descriptive User-Agent with a contact. Set your own, e.g. "FinRobot you@example.com".
SEC_USER_AGENT=

DATABASE_URL=postgresql://finrobot:finrobot@127.0.0.1:5433/finrobot
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=finrobot
S3_SECRET_KEY=finrobot-secret
S3_BUCKET=finrobot

OLLAMA_HOST=http://127.0.0.1:11434
# gpt-oss:20b does figures and fact-checks; gemma4:e4b does narrative. Only one fits the 16 GB GPU at a time.
FINROBOT_MODEL_FIGURES=gpt-oss:20b
FINROBOT_MODEL_NARRATIVE=gemma4:e4b
FINROBOT_EMBED_MODEL=nomic-embed-text
FINROBOT_NUM_CTX=8192

# Optional: official Alpha Vantage API for prices (free key). Otherwise use `finrobot set-price` / `import-prices`.
ALPHAVANTAGE_API_KEY=
