# Copy to .env and edit. `docker compose` and the CLI both read it. Never commit .env.

# --- required ------------------------------------------------------------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent with contact details: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=
POSTGRES_PASSWORD=change-me-postgres
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret-key-min-8
# API keys clients must send as `x-api-key` (comma separated). Generate with: openssl rand -hex 24
FINROBOT_API_KEYS=change-me-api-key
FINROBOT_UI_API_KEY=change-me-api-key        # the UI's key: must be one of the keys above

# --- local development without docker for the app (compose for postgres/objects only) ------------------------------------
# DATABASE_URL=postgresql://finrobot:change-me-postgres@127.0.0.1:5433/finrobot
# S3_ENDPOINT=127.0.0.1:9000
# FINROBOT_ENV=development

# --- models ----------------------------------------------------------------------------------------------------------------
# [provider:]model. Bare names are Ollama models; hosted providers need their extra (uv sync --extra anthropic).
OLLAMA_HOST=http://127.0.0.1:11434
# gpt-oss:20b does figures and fact-checks; gemma4:e4b does narrative. Only one fits a 16 GB GPU at a time.
FINROBOT_MODEL_FIGURES=gpt-oss:20b
FINROBOT_MODEL_NARRATIVE=gemma4:e4b
# e.g. FINROBOT_MODEL_NARRATIVE=anthropic:claude-sonnet-5-5   (and ANTHROPIC_API_KEY=...)
FINROBOT_EMBED_MODEL=nomic-embed-text
FINROBOT_EMBED_DIM=768                        # must match the pgvector column; changing models means re-ingesting
FINROBOT_NUM_CTX=8192
FINROBOT_LLM_CONCURRENCY=1                    # concurrent model calls; 1 = a single GPU slot

# --- observability (all optional; see docs/observability.md) ----------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com  # or your self-hosted URL, e.g. http://langfuse-web:3000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finrobot
# false = send timings and scores only; prompts and outputs (company data, model text) are redacted before leaving the process
FINROBOT_TRACE_INPUTS=true

# --- misc -----------------------------------------------------------------------------------------------------------------
# Official Alpha Vantage API for prices (free key). Otherwise use `finrobot set-price` / `import-prices`.
ALPHAVANTAGE_API_KEY=
FINROBOT_LOG_LEVEL=INFO
